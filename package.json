{
    "name": "arikajs-monorepo",
    "private": true,
    "description": "A Modern, Elegant Web Framework for Node.js",
    "packageManager": "pnpm@10.5.2",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev --parallel",
        "test": "turbo test",
        "lint": "turbo lint",
        "clean": "turbo clean && rm -rf packages/*/dist packages/*/node_modules node_modules pnpm-lock.yaml",
        "change": "changeset",
        "version-packages": "changeset version",
        "release": "pnpm build && pnpm publish -r --access public --no-git-checks"
    },
    "pnpm": {
        "overrides": {
            "typescript": "^5.9.3",
            "consolidate": "^1.0.4",
            "prebuild-install": "^7.1.3",
            "node-domexception": "skip"
        },
        "onlyBuiltDependencies": [
            "better-sqlite3",
            "esbuild",
            "sharp"
        ],
        "ignoredBuiltDependencies": [
            "better-sqlite3",
            "esbuild"
        ]
    },
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@changesets/cli": "^2.30.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.1",
        "pnpm": "^10.30.3",
        "turbo": "^2.8.13",
        "typescript": "^5.9.3"
    }
}