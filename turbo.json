{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "inputs": [
                "src/**/*.ts",
                "tests/**/*.ts"
            ],
            "env": [
                "NODE_ENV",
                "APP_KEY",
                "APP_ENV"
            ]
        },
        "lint": {
            "outputs": []
        },
        "clean": {
            "cache": false
        }
    }
}